DATABASE_URL="postgresql://user:password@host:5432/dbname"
GOOGLE_PLACES_KEY=your_google_places_api_key_here
PORT=3000
AUTH0_AUDIENCE=https://api.sensemap.app
AUTH0_ISSUER_BASE_URL=https://your-auth0-domain.auth0.com
GEMINI_API_KEY=your_gemini_api_key_here
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM="SenseMap <hello@sensemap.app>"
ADMIN_NOTIFY_EMAIL=you@example.com
# Public backend URL — used to build the unsubscribe link in weekly digest emails
API_BASE_URL=https://api.sensemap.app
# Enrichment run size: max places one run (nightly, /enrichment/trigger, even force=true) may process. Default 50, clamped 1-1000.
ENRICHMENT_MAX_PER_RUN=50
# Pause between places during an enrichment run, in ms. Default 2000, clamped 0-60000.
ENRICHMENT_DELAY_MS=2000
# Catch-up runs (boot catch-up AND the hourly missed-run check share one rule): on only when RAILWAY_ENVIRONMENT is set
# or this is "true"; always off when "false" or NODE_ENV=test. Leave unset locally so a dev server never starts paid runs.
ENRICHMENT_CATCHUP=
