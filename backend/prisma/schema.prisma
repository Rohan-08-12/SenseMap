// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}



model User {
  id             String          @id @default(uuid())
  auth0Id        String          @unique
  email          String          @unique
  username       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  savedPlaces    SavedPlace[]
  reviews        Review[]
  checkIns       CheckIn[]
  sensoryProfile SensoryProfile?
}

model Location {
  id             String        @id @default(uuid())
  googlePlaceId  String?       @unique
  name           String
  description    String?
  category       String?
  address        String?
  imageUrl       String?
  longitude      Float
  latitude       Float
  embedding      Float[]
  audioUrl          String?
  audioGeneratedAt  DateTime?

  estimatedNoiseScore     Float?
  estimatedLightingScore  Float?
  estimatedCrowdScore     Float?
  estimatedFacilities     Json?
  dataSource              String    @default("category")
  externalYelpId          String?
  lastEnrichedAt          DateTime?
  enrichmentConfidence    Float?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  savedBy        SavedPlace[]
  reviews        Review[]
  checkIns       CheckIn[]
  sensoryScores  SensoryScore?

  @@index([category])
}

model Review {
  id              String    @id @default(uuid())
  userId          String
  locationId      String
  bodyText        String
  rating          Int
  visitedAt       DateTime?
  createdAt       DateTime  @default(now())

  imageUrl        String?

  noiseLevel      Int?
  lightingLevel   Int?
  crowdLevel      Int?
  visitTime      String?

  aiNoiseScore    Float?
  aiLightingScore Float?
  aiCrowdScore    Float?
  aiSentiment     String?
  aiTags          String[]
  isAiGenerated   Boolean   @default(false)

  temperature        Json?
  seating            Json?
  bathrooms          Json?
  socialInteractions Json?

  user            User      @relation(fields: [userId], references: [id])
  location        Location  @relation(fields: [locationId], references: [id])

  @@index([locationId])
  @@index([userId])
}

model SensoryScore {
  id            String   @id @default(uuid())
  locationId    String   @unique
  noiseScore    Float
  lightingScore Float
  crowdScore    Float
  comfortScore  Float
  reviewCount   Int      @default(0)
  updatedAt     DateTime @updatedAt

  location      Location @relation(fields: [locationId], references: [id])
}

model SensoryProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  noiseTolerance     Int
  lightingTolerance  Int
  crowdTolerance     Int
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id])
}

model SavedPlace {
  id         String   @id @default(uuid())
  userId     String
  locationId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  location   Location @relation(fields: [locationId], references: [id])

  @@unique([userId, locationId])
}

model CheckIn {
  id         String   @id @default(uuid())
  userId     String
  locationId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  location   Location @relation(fields: [locationId], references: [id])

  @@index([userId])
  @@index([locationId])
}

model EnrichmentLog {
  id         String   @id @default(uuid())
  locationId String
  updatedAt  DateTime @default(now())
  scores     Json
}

// One row per enrichment run (nightly cron, n8n/manual trigger). Doubles as the overlap lock:
// a partial unique index (see migration 20261119000000_add_enrichment_run) allows at most one status='running' row.
model EnrichmentRun {
  id           String    @id @default(uuid())
  trigger      String    // "cron" | "trigger" | "trigger-force"
  force        Boolean   @default(false)
  status       String    @default("running") // running | success | failed | abandoned
  startedAt    DateTime  @default(now())
  heartbeatAt  DateTime  @default(now())
  finishedAt   DateTime?
  planned      Int       @default(0)
  updated      Int       @default(0)
  skipped      Int       @default(0)
  failed       Int       @default(0)
  errors       Json?     // capped list of { location, message }
  errorMessage String?   // fatal error that aborted the run

  @@index([status, finishedAt])
  @@index([startedAt])
}

model EmailSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
  source    String?
}